@{
    ViewBag.Title = "Open New Account";
}

<style>
    body {
        background: #f4f7fc;
    }

    .account-container {
        max-width: 750px;
        margin: 40px auto;
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .account-header {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        color: white;
        text-align: center;
        padding: 25px;
    }

    .account-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            font-weight: 600;
            display: block;
            margin-bottom: 6px;
            color: #333;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    textarea.form-control {
        height: 100px;
        resize: none;
    }

    .btn-submit {
        width: 100%;
        background: #0d6efd;
        color: white;
        border: none;
        padding: 14px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-submit:hover {
            background: #0b5ed7;
        }

    .success-box {
        margin-top: 20px;
        padding: 18px;
        background: #d4edda;
        color: #155724;
        border-radius: 10px;
        border: 1px solid #c3e6cb;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        text-decoration: none;
        color: #0d6efd;
        font-weight: 600;
    }
</style>

<div class="account-container">

    <div class="account-header">
        <h2>Open New Bank Account</h2>
        <p>Submit your details for account opening</p>
    </div>

    <div class="account-body">
        @*@if (ViewBag.Error != null)
        {
            <div style="color:red; margin-bottom:15px;">
                @ViewBag.Error
            </div>
        }*@

        <form method="post" action="/AccountRequest/Submit">

            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="FullName" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="Email" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Mobile Number</label>
                <input type="text" name="Mobile" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Date Of Birth</label>
                <input type="date" name="Dob" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Aadhar Number</label>
                <input type="text" name="AadharNo" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Occupation</label>
                <input type="text" name="Occupation" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Address</label>
                <textarea name="Address" class="form-control" required></textarea>
            </div>

            <button type="submit" class="btn-submit">
                Submit Account Request
            </button>

        </form>

        @if (ViewBag.Result != null)
        {
            <div class="success-box">

                <h4>✅ @ViewBag.Result</h4>

                <p>
                    Your account opening request has been submitted successfully.
                </p>

                <p>
                    <strong>Reference Number:</strong>
                    @ViewBag.ReferenceNo
                </p>

                <p>
                    Please save this reference number for future tracking.
                </p>

            </div>
        }

        <a href="/Home/Index" class="back-link">
            ← Back To Home
        </a>

    </div>

</div>
