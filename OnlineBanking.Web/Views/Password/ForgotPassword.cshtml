@{
    ViewBag.Title = "Forgot Password";
}

<style>

    .forgot-container {
        max-width: 550px;
        margin: auto;
        background: white;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .forgot-header {
        text-align: center;
        margin-bottom: 25px;
    }

        .forgot-header h2 {
            color: #0d6efd;
            margin-bottom: 8px;
        }

        .forgot-header p {
            color: gray;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

    .reset-btn {
        width: 100%;
        background: #0d6efd;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
    }

        .reset-btn:hover {
            background: #0a3d91;
        }

    .result-box {
        margin-top: 20px;
        padding: 15px;
        border-radius: 8px;
        background: #eef4ff;
        border-left: 5px solid #0d6efd;
        font-weight: bold;
    }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        text-decoration: none;
        color: #0d6efd;
        font-weight: bold;
    }
</style>

<div class="forgot-container">

    <div class="forgot-header">
        <h2>Forgot Password</h2>
        <p>Reset your Net Banking Login Password</p>
    </div>

    <form method="post" action="/Password/ResetPassword">

        <div class="form-group">
            <label>User Name</label>
            <input type="text"
                   name="username"
                   required />
        </div>

        <div class="form-group">
            <label>New Login Password</label>
            <input type="password"
                   name="newPassword"
                   required />
        </div>

        <button type="submit" class="reset-btn">
            Reset Password
        </button>

    </form>

    @if (ViewBag.Result != null)
    {
        <div class="result-box">
            @ViewBag.Result
        </div>
    }

    <a href="/Login/Index" class="back-link">
        ← Back To Login
    </a>

</div>