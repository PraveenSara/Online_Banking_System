@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Online Banking Login</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: linear-gradient(135deg,#0d6efd,#0a3d91);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            width: 900px;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        }

        .left-panel {
            width: 50%;
            background: #0d6efd;
            color: white;
            padding: 50px;
        }

            .left-panel h1 {
                margin-top: 50px;
                font-size: 35px;
            }

            .left-panel p {
                font-size: 16px;
                line-height: 25px;
            }

        .right-panel {
            width: 50%;
            padding: 50px;
        }

            .right-panel h2 {
                text-align: center;
                margin-bottom: 30px;
                color: #0d6efd;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                font-weight: bold;
            }

            .form-group input {
                width: 100%;
                padding: 12px;
                border: 1px solid #ccc;
                border-radius: 5px;
                margin-top: 5px;
            }

        .login-btn {
            width: 100%;
            padding: 12px;
            background: #0d6efd;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

            .login-btn:hover {
                background: #084298;
            }

        .links {
            text-align: center;
            margin-top: 20px;
        }

            .links a {
                text-decoration: none;
                color: #0d6efd;
                display: block;
                margin-top: 10px;
            }

        .error {
            color: red;
            text-align: center;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="left-panel">
            <h1>Online Banking</h1>

            <p>
                Secure Banking Anytime, Anywhere.
            </p>

            <p>
                Transfer Funds, Manage Beneficiaries,
                View Statements and Access Account
                Services Online.
            </p>
        </div>

        <div class="right-panel">

            <h2>Login</h2>

            @if (ViewBag.Error != null)
            {
                <div class="error">
                    @ViewBag.Error
                </div>
            }

            <form method="post" action="/Login/Login">

                <div class="form-group">
                    <label>Username</label>
                    <input type="text"
                           name="username"
                           required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password"
                           name="password"
                           required />
                </div>

                <button type="submit" class="login-btn">
                    Login
                </button>

            </form>

            <div class="links">

                <a href="/Password/ForgotPassword">
                    Forgot Password?
                </a>

                <a href="/User/Register">
                    Register For Net Banking
                </a>

                <a href="/AccountRequest/Index">
                    Open New Account
                </a>

            </div>

        </div>

    </div>

</body>
</html>
